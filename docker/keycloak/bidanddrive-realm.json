{
  "realm": "bidanddrive",
  "displayName": "BidAndDrive",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "SELLER",
        "description": "Can create auctions"
      },
      {
        "name": "BUYER",
        "description": "Can bid on auctions"
      }
    ]
  },
  "clients": [
    {
      "clientId": "auction-frontend",
      "name": "BidAndDrive frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "phone",
        "roles",
        "web-origins",
        "acr"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "auction-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "auction-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "seller",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Seller",
      "email": "seller@bidanddrive.local",
      "attributes": {
        "phoneNumber": [
          "+33600000001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "seller",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-bidanddrive",
        "SELLER"
      ]
    },
    {
      "username": "buyer1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Martin",
      "email": "buyer1@bidanddrive.local",
      "attributes": {
        "phoneNumber": [
          "+33600000011"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "buyer1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-bidanddrive",
        "BUYER"
      ]
    },
    {
      "username": "buyer2",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bruno",
      "lastName": "Dubois",
      "email": "buyer2@bidanddrive.local",
      "attributes": {
        "phoneNumber": [
          "+33600000012"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "buyer2",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-bidanddrive",
        "BUYER"
      ]
    },
    {
      "username": "buyer3",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Chloe",
      "lastName": "Bernard",
      "email": "buyer3@bidanddrive.local",
      "attributes": {
        "phoneNumber": [
          "+33600000013"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "buyer3",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-bidanddrive",
        "BUYER"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false, \"required\": {\"roles\": [\"user\"]}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false, \"required\": {\"roles\": [\"user\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false, \"required\": {\"roles\": [\"user\"]}}, {\"name\": \"phoneNumber\", \"displayName\": \"Phone number\", \"validations\": {\"length\": {\"min\": 8, \"max\": 20}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false, \"required\": {\"roles\": [\"user\"]}}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
