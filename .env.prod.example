# Copy to .env.prod, fill in, and keep it out of git:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- Public URLs (behind your TLS reverse proxy), without trailing slash -- required
APP_PUBLIC_URL=https://bidanddrive.example.com
KEYCLOAK_PUBLIC_URL=https://auth.example.com

# --- Secrets -- required (use long random values, e.g. `openssl rand -base64 32`)
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=

# --- Optional (defaults shown)
# POSTGRES_DB=auction
# POSTGRES_USER=auction
# KEYCLOAK_DB_USER=keycloak
# KEYCLOAK_ADMIN_USER=admin
# OAUTH2_AUDIENCE=auction-api
# FRONTEND_PORT=80
# KEYCLOAK_PORT=8180
# API_DOCS_ENABLED=false
# BACKEND_JAVA_OPTS=
# BACKEND_IMAGE=bidanddrive-backend
# FRONTEND_IMAGE=bidanddrive-frontend
# IMAGE_TAG=latest
